{
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true,
        "config_path": "biome.json"
      }
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": [
        "!eslint",
        "!typescript-language-server",
        "!vtsls",
        "tsgo",
        "..."
      ],
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TypeScript": {
      "language_servers": [
        "!eslint",
        "!typescript-language-server",
        "!vtsls",
        "tsgo",
        "..."
      ],
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TSX": {
      "language_servers": [
        "tsgo",
        "!eslint",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ],
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },

    "JSONC": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    }
  }
}
