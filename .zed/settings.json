{
  "lsp": {
    "biome": {
      "binary": {
        "path": "node_modules/@biomejs/biome/bin/biome",
        "arguments": ["lsp-proxy"]
      },
      "settings": {
        "config_path": "backend/biome.json",
        "require_config_file": true
      }
    },
    "typescript-ls": {
      "settings": {
        "typescript": {
          "preferences": {
            "includePackageJsonAutoImports": "on"
          }
        }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": [
        "!eslint",
        "!typescript-language-server",
        "!vtsls",
        "typescript-ls",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TypeScript": {
      "language_servers": [
        "!eslint",
        "!typescript-language-server",
        "!vtsls",
        "typescript-ls",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TSX": {
      "language_servers": [
        "!eslint",
        "!vtsls",
        "!typescript-language-server",
        "typescript-ls",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JSON": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JSONC": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    }
  },
  "format_on_save": "on",
  "formatter": "language_server"
}
